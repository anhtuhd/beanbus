# Application
NEXT_PUBLIC_APP_MODE=demo
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (required when NEXT_PUBLIC_APP_MODE=production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_ENABLE_PHONE_AUTH=false
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
NEXT_PUBLIC_ENABLE_PASSWORD_AUTH=false
PASSWORD_RECOVERY_SECRET=
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=false
NEXT_PUBLIC_ENABLE_GUEST_NOTIFICATIONS=false
NEXT_PUBLIC_ENABLE_WEB_PUSH=false
NOTIFICATION_EMAIL_MODE=disabled
GUEST_NOTIFICATION_SECRET=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
NEXT_PUBLIC_ENABLE_R2_MEDIA=false
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://images.beanbus.store
R2_ACCOUNT_ID=
R2_BUCKET_NAME=beanbus-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CATALOG_MENU_MODE=legacy
# Phone auth uses the Supabase Auth CAPTCHA setting; form protection is separately feature-gated.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_ENABLE_FORM_CAPTCHA=false
TURNSTILE_SECRET_KEY=

# Sepay (required only when NEXT_PUBLIC_ENABLE_SEPAY=true; HMAC webhook recommended)
NEXT_PUBLIC_ENABLE_SEPAY=false
NEXT_PUBLIC_ENABLE_SEPAY_RECONCILIATION=false
NEXT_PUBLIC_ENABLE_STORED_VALUE=false
NEXT_PUBLIC_ENABLE_POINTS_PAYMENT=false
ENABLE_ADMIN_ASSISTED_ORDERS=false
ENABLE_POS_STAFF=false
NEXT_PUBLIC_ENABLE_VOUCHER_WALLET=false
MEMBER_PASS_SECRET=
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_CODE=
SEPAY_BANK_ACCOUNT=
SEPAY_ACCOUNT_NAME=
# Required when NEXT_PUBLIC_ENABLE_SEPAY_RECONCILIATION=true
SEPAY_API_KEY=
CRON_SECRET=
