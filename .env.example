# Application
NEXT_PUBLIC_APP_MODE=demo
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (required when NEXT_PUBLIC_APP_MODE=production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_ENABLE_PHONE_AUTH=false
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
# Public widget key only. Keep the Turnstile secret in Supabase Auth settings.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Sepay (required only when NEXT_PUBLIC_ENABLE_SEPAY=true; HMAC webhook recommended)
NEXT_PUBLIC_ENABLE_SEPAY=false
NEXT_PUBLIC_ENABLE_STORED_VALUE=false
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_CODE=
SEPAY_BANK_ACCOUNT=
SEPAY_ACCOUNT_NAME=
# Optional future reconciliation API access
SEPAY_API_KEY=
